# ─────────────────────────────────────────────────────────────
# ProjectBridge — Environment Variables
# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file. Keep secrets out of git.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────
# These are read by the browser via import.meta.env.
# Supabase project URL and anon (publishable) key.
# Find these in your Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Edge Functions (Supabase secrets) ───────────────────────
# These are set as Supabase Edge Function secrets, NOT in the
# frontend .env. They are server-side only and never reach the browser.
# Set them via the Supabase Dashboard → Edge Functions → Secrets.

# Supabase service role key — used by edge functions to run with
# elevated privileges (bypasses RLS). NEVER expose in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key — enables live AI project planning.
# If unset, the generate-project-plan edge function falls back to
# a clearly-labeled demo plan. Get a key at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
